# Server port and public site URL
PORT=3001
APP_URL=http://localhost:3000

# Address that receives new audit requests
CONTACT_EMAIL=you@example.com

# SMTP credentials (use an app password with Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Optional: value used in the From header. Keep this on the same domain as SMTP_USER.
SMTP_FROM="Sanjse SEO Website <you@example.com>"
